# ══════════════════════════════════════════════════════════════
# 🚀 ShellSage v4.0 — Environment Configuration
# Every provider below works identically: set <PREFIX>_API_KEY
# (+ optional <PREFIX>_MODEL / <PREFIX>_BASE_URL). No code needed.
# ══════════════════════════════════════════════════════════════

# Active provider id (see: shellsage provider list)
SHELLSAGE_PROVIDER=openrouter

# Global overrides (optional)
# SHELLSAGE_MODEL=
# SHELLSAGE_TEMP=0.7
# SHELLSAGE_STREAM=true
# SHELLSAGE_APPROVE=ask   # ask | yolo | read-only
# SHELLSAGE_MAX_CONTEXT_TOKENS=60000
# SHELLSAGE_ALLOW_LOCAL_NET=0   # allow agent http_request to private ranges (dev only)

# ── OpenRouter ── (Unified hub for 300+ models (free & paid))
# OPENROUTER_API_KEY:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── OpenAI ── (GPT-4.1, GPT-4o, o-series reasoning models)
# OPENAI_API_KEY:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic Claude ── (Claude 4 Sonnet/Opus & Claude 3.5 family)
# ANTHROPIC_API_KEY:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ── Google Gemini ── (Gemini 2.5 Pro/Flash via OpenAI-compatible endpoint)
# GEMINI_API_KEY or GOOGLE_API_KEY:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── Groq Cloud ── (Ultra-fast LPU inference (500+ tok/s))
# GROQ_API_KEY:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── DeepSeek ── (DeepSeek-V3 & DeepSeek-R1 reasoning)
# DEEPSEEK_API_KEY:
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Mistral AI ── (Mistral Large & Codestral (EU frontier models))
# MISTRAL_API_KEY:
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── xAI (Grok) ── (Grok 4 / Grok 3 with 128k context)
# XAI_API_KEY:
XAI_API_KEY=
XAI_MODEL=grok-3
# XAI_BASE_URL=https://api.x.ai/v1

# ── Together AI ── (Open-source model hosting (Llama, DeepSeek, Qwen))
# TOGETHER_API_KEY or TOGETHERAI_API_KEY:
TOGETHER_API_KEY=
TOGETHER_MODEL=deepseek-ai/DeepSeek-V3
# TOGETHER_BASE_URL=https://api.together.xyz/v1

# ── Fireworks AI ── (High-throughput inference on frontier open models)
# FIREWORKS_API_KEY:
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ── Cerebras Inference ── (~1000 tok/s wafer-scale inference, generous free tier)
# CEREBRAS_API_KEY:
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ── NVIDIA NIM ── (Optimized models on NVIDIA GPU cloud (free credits))
# NVIDIA_API_KEY:
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-r1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── GitHub Models ── (Use your GitHub token — no extra signup (free tier))
# GITHUB_API_KEY or GITHUB_TOKEN or GH_TOKEN:
GITHUB_API_KEY=
GITHUB_MODEL=gpt-4o
# GITHUB_BASE_URL=https://models.inference.ai.azure.com

# ── Hugging Face Inference ── (Router for thousands of open models)
# HUGGINGFACE_API_KEY or HF_TOKEN:
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# ── Perplexity ── (Sonar models with built-in live web search)
# PERPLEXITY_API_KEY:
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# PERPLEXITY_BASE_URL=https://api.perplexity.ai

# ── DeepInfra ── (Low-cost serverless open models)
# DEEPINFRA_API_KEY:
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# ── Cohere ── (Command A / R-series for enterprise & RAG)
# COHERE_API_KEY:
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
# COHERE_BASE_URL=https://api.cohere.com/v2

# ── Azure OpenAI ── (Enterprise deployment: base URL + model = deployment name)
# AZURE_OPENAI_API_KEY:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4o
# or set AZURE_OPENAI_ENDPOINT (resource endpoint)
# AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1

# ── Ollama (Local) ── (Private offline models on your machine)
OLLAMA_MODEL=llama3.2:latest
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Custom / Self-Hosted ── (Any OpenAI-compatible server (vLLM, LM Studio, llama.cpp))
SHELLSAGE_CUSTOM_MODEL=default-model
# SHELLSAGE_CUSTOM_BASE_URL=http://localhost:8080/v1

