# EditorConfig helps maintain consistent coding styles for multiple developers
# working on the same project across various editors and IDEs.
# editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.go]
indent_style = tab
indent_size = 1

[*.md]
trim_trailing_whitespace = false

[{Makefile,makefile}]
indent_style = tab
indent_size = 1

[*.{json,yaml,yml}]
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2
